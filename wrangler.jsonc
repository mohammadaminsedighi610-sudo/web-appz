{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appz",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "45a9b7da-a9c5-406f-a591-455e9d44a714","database_name": "web-appD1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "41af86ce432d403aaa1913383fbbc385" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
